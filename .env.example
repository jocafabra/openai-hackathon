# OpenAI is optional. Without it, the operational structured forms and deterministic engine still work.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional live cash-flight source. Without it, the hub uses an identified deterministic mock provider.
SERPAPI_API_KEY=

# Used by Docker Compose. Change outside local demo environments.
POSTGRES_PASSWORD=milesai_local
MILESAI_PORT=3107

NEXT_PUBLIC_DEMO_MODE=true
